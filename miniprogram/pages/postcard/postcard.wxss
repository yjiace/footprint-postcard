/* pages/postcard/postcard.wxss */

/* 固定背景层 - 覆盖整个屏幕，不随滚动移动 */
.bg-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #fde68a 0%, #a78bfa 50%, #60a5fa 100%);
  z-index: -1;
}

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 50rpx 32rpx 0;
  box-sizing: border-box;
}

.postcard-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 0;
  box-sizing: border-box;
  width: 100%;
}

.postcard-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  transition: all 0.3s;
}

.postcard-item:active {
  transform: scale(0.95);
}

/* 使用 padding-bottom 实现 3:4 高宽比，兼容性更好 */
.postcard-image-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 133.33%; /* 4/3 = 1.3333 即 133.33% */
  overflow: hidden;
  border-radius: 16rpx;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.postcard-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.postcard-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 未登录状态容器 - 与行程页面保持一致 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  height: 60vh;
  color: #FFFFFF;
}

.empty-icon {
  font-size: 120rpx;
}

/* 空状态（已登录但无数据）*/
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 128rpx 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.empty-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  line-height: 1.6;
}

.login-btn {
  margin-top: 32rpx;
  padding: 24rpx 64rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.login-btn:active {
  transform: scale(0.95);
  background-color: rgba(255, 255, 255, 1);
}

.login-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #a78bfa;
}

.bottom-placeholder {
  height: 0;
}
