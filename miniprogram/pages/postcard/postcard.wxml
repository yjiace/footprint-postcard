<!--pages/postcard/postcard.wxml-->
<view class="page-container">
  <!-- 固定渐变背景层 -->
  <view class="bg-gradient"></view>

  <!-- 固定导航栏 -->
  <custom-navbar title="明信片"></custom-navbar>

  <scroll-view class="content-scroll" scroll-y refresher-enabled="{{isLoggedIn}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="onScrollToLower" lower-threshold="100">
    <!-- 未登录状态 -->
    <view class="empty-container" wx:if="{{!isLoggedIn}}">
      <view class="empty-icon">🔐</view>
      <text class="empty-title">请先登录</text>
      <text class="empty-desc">登录后查看和制作您的明信片</text>
      <view class="login-btn" bindtap="goLogin">
        <text>立即登录</text>
      </view>
    </view>

    <!-- 明信片网格 -->
    <view class="postcard-grid" wx:elif="{{postcardList.length > 0}}">
      <view 
        class="postcard-item"
        wx:for="{{postcardList}}"
        wx:key="id"
        bindtap="onPostcardTap"
        bindlongpress="onLongPress"
        data-item="{{item}}"
        data-index="{{index}}"
      >
        <view class="postcard-image-wrapper">
          <image class="postcard-image" src="{{item.thumbnail || item.image}}" mode="aspectFill" lazy-load></image>
        </view>
        <text class="postcard-title">{{item.title}}</text>
      </view>
    </view>

    <!-- 底部状态提示（合并分页信息和加载状态）-->
    <view class="load-more" wx:if="{{postcardList.length > 0}}">
      <view class="loading-indicator" wx:if="{{loadingMore}}">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>
      <text class="load-hint" wx:elif="{{hasMore}}">共 {{totalCount || postcardList.length}} 张 · 上滑加载更多</text>
      <text class="no-more" wx:else>共 {{totalCount || postcardList.length}} 张 · 没有更多了</text>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-placeholder"></view>
  </scroll-view>
</view>