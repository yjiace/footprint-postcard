<!--pages/plan-list/plan-list.wxml-->
<view class="page-container">
  <!-- 固定渐变背景层 -->
  <view class="bg-gradient"></view>

  <!-- 固定导航栏 -->
  <custom-navbar title="我的行程"></custom-navbar>

  <scroll-view class="content-scroll" scroll-y scroll-top="{{scrollTop}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscroll="onScroll" bindtap="onPageTap">
    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-container">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 未登录状态 -->
    <view wx:elif="{{!isLoggedIn}}" class="empty-container">
      <view class="empty-icon">🔐</view>
      <text class="empty-title">请先登录</text>
      <text class="empty-desc">登录后查看和管理您的行程规划</text>
      <view class="login-btn" bindtap="goLogin">
        <text>立即登录</text>
      </view>
    </view>

    <!-- 空状态（已登录但无数据）-->
    <view wx:elif="{{!planList || planList.length === 0}}" class="empty-container">
      <view class="empty-icon">📋</view>
      <text class="empty-title">暂无行程规划</text>
      <text class="empty-desc">点击右下角 + 开始规划您的旅行</text>
    </view>

    <!-- 列表 -->
    <view wx:else class="plan-list">
      <view 
        class="plan-card-wrapper" 
        wx:for="{{planList}}" 
        wx:key="id"
      >
        <view 
          class="plan-card {{item.status === 'generating' ? 'generating' : ''}} {{item.status === 'failed' ? 'failed' : ''}}"
          bindtap="onViewDetail"
          data-id="{{item.id}}"
          data-status="{{item.status}}"
          data-index="{{index}}"
        >
          <view class="plan-card-main">
            <!-- 城市封面图片 -->
            <image 
              wx:if="{{item.cityImage}}" 
              class="city-cover-image" 
              src="{{item.cityImage}}" 
              mode="aspectFill"
              lazy-load
            />
            <view class="plan-info">
              <view class="plan-header">
                <text class="city-name">{{item.city}}</text>
                <text class="plan-days-tag">{{item.days}}天</text>
              </view>
              <view class="plan-meta">
                <text class="plan-date">📅 {{item.date}} 至 {{item.endDate}}</text>
                <!-- 状态标签 -->
                <view wx:if="{{item.status === 'generating'}}" class="status-tag generating">
                  <view class="status-spinner"></view>
                  <text>生成中</text>
                </view>
                <view wx:elif="{{item.status === 'failed'}}" class="status-tag failed">
                  <text>生成失败</text>
                </view>
              </view>
              <!-- 偏好标签 -->
              <view class="plan-tags" wx:if="{{item.status === 'completed'}}">
                <text class="tag-item transport" wx:if="{{item.transportation}}">{{item.transportIcon}} {{item.transportation}}</text>
                <text class="tag-item hotel" wx:if="{{item.accommodation}}">{{item.accommodationIcon}} {{item.accommodation}}</text>
              </view>
              <!-- 右下角菜单按钮（非生成中状态显示）-->
              <view class="card-menu-btn" wx:if="{{item.status !== 'generating'}}" catchtap="onToggleMenu" data-index="{{index}}">
                <text class="menu-dots">•••</text>
              </view>
            </view>
          </view>
          <!-- 下拉菜单 -->
          <view class="dropdown-menu {{item.menuOpen ? 'show' : ''}}" wx:if="{{item.status !== 'generating'}}">
            <view class="menu-item" catchtap="onGeneratePostcard" data-id="{{item.id}}" data-city="{{item.city}}" data-index="{{index}}">
              <text class="menu-icon">🖼️</text>
              <text>生成明信片</text>
            </view>
            <view class="menu-item danger" catchtap="onDelete" data-id="{{item.id}}" data-city="{{item.city}}" data-index="{{index}}">
              <text class="menu-icon">🗑️</text>
              <text>删除行程</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多状态 -->
    <view wx:if="{{!loading && planList.length > 0}}" class="load-more-container">
      <view wx:if="{{loadingMore}}" class="load-more-loading">
        <view class="loading-spinner-small"></view>
        <text>加载中...</text>
      </view>
      <view wx:elif="{{!hasMore}}" class="load-more-end">
        <text>— 已经到底了 —</text>
      </view>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- 回到顶部按钮 -->
  <view class="back-to-top {{showBackTop ? 'show' : ''}}" bindtap="scrollToTop">
    <text class="back-top-icon">↑</text>
  </view>

  <!-- 悬浮添加按钮（仅登录后显示）-->
  <view class="fab-container" wx:if="{{isLoggedIn}}">
    <view class="fab-btn" bindtap="onAdd">
      <text class="fab-icon">+</text>
    </view>
  </view>

  <!-- 明信片生成加载动画 -->
  <postcard-loading id="postcardLoading" visible="{{showPostcardLoading}}" />
</view>
