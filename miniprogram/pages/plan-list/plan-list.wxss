/* pages/plan-list/plan-list.wxss */

/* 固定背景层 - 覆盖整个屏幕，不随滚动移动 */
.bg-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #fde68a 0%, #a78bfa 50%, #60a5fa 100%);
  z-index: -1;
}

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 50rpx 32rpx 0;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #FFFFFF;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top: 6rpx solid #FFFFFF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #FFFFFF;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  height: 60vh;
  color: #FFFFFF;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.empty-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  max-width: 400rpx;
}

.login-btn {
  margin-top: 32rpx;
  padding: 24rpx 64rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.login-btn:active {
  transform: scale(0.95);
}

.login-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #a78bfa;
}

/* 列表 */
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.plan-card-wrapper {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
}

.plan-card {
  transition: transform 0.3s ease;
}

.plan-card.swiped {
  transform: translateX(-200rpx);
}

/* 左滑时取消右侧圆角 */
.plan-card.swiped .plan-card-main {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

.plan-card-main {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: border-radius 0.3s ease;
}

/* 城市封面图片 */
.city-cover-image {
  width: 100%;
  height: 200rpx;
  display: block;
}

/* 行程信息容器 */
.plan-info {
  padding: 24rpx 28rpx;
}

/* 偏好标签行 */
.plan-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-item.transport {
  background-color: #dbeafe;
  color: #1d4ed8;
}

.tag-item.hotel {
  background-color: #fce7f3;
  color: #be185d;
}

.tag-item.poi {
  background-color: #d1fae5;
  color: #047857;
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.city-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.plan-days-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #a78bfa 0%, #60a5fa 100%);
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* 状态标签 */
.status-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-tag.generating {
  background-color: #fef3c7;
  color: #d97706;
}

.status-tag.failed {
  background-color: #fee2e2;
  color: #dc2626;
}

.status-spinner {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #fcd34d;
  border-top: 3rpx solid #d97706;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* 生成中状态卡片 */
.plan-card.generating .plan-card-main {
  position: relative;
  overflow: hidden;
}

.plan-card.generating .plan-card-main::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.2), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* 失败状态卡片 */
.plan-card.failed .plan-card-main {
  border: 2rpx solid #fca5a5;
}

.plan-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-date {
  font-size: 26rpx;
  color: #6b7280;
}

/* 右下角菜单按钮 */
.card-menu-btn {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
}

.card-menu-btn:active {
  background: rgba(0, 0, 0, 0.1);
}

.menu-dots {
  font-size: 24rpx;
  color: #6b7280;
  letter-spacing: 2rpx;
}

/* 下拉菜单 */
.dropdown-menu {
  position: absolute;
  bottom: 70rpx;
  right: 16rpx;
  min-width: 200rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  opacity: 0;
  transform: translateY(10rpx) scale(0.95);
  pointer-events: none;
  transition: all 0.2s ease;
  z-index: 100;
  overflow: hidden;
}

.dropdown-menu.show {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #374151;
  border-bottom: 1rpx solid #f3f4f6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f9fafb;
}

.menu-item.danger {
  color: #ef4444;
}

.menu-icon {
  font-size: 32rpx;
}

/* 加载更多 */
.load-more-container {
  padding: 32rpx 0;
  text-align: center;
}

.load-more-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

.loading-spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #FFFFFF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.load-more-end {
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
}

/* 悬浮按钮 */
.fab-container {
  position: fixed;
  right: 48rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.fab-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #a78bfa;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(167, 139, 250, 0.4);
  transition: all 0.3s;
}

.fab-btn:active {
  transform: scale(0.9);
  box-shadow: 0 8rpx 24rpx rgba(167, 139, 250, 0.3);
}

.fab-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

/* 底部占位 */
.bottom-placeholder {
  height: 120rpx;
}

/* 回到顶部按钮 */
.back-to-top {
  position: fixed;
  right: 48rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
  z-index: 99;
  opacity: 0;
  transform: scale(0.8);
  pointer-events: none;
  transition: all 0.3s ease;
}

.back-to-top.show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.back-to-top:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 1);
}

.back-top-icon {
  font-size: 48rpx;
  color: #a78bfa;
  font-weight: 300;
  line-height: 1;
}
