/* pages/agreement/agreement.wxss */

.agreement-container {
    height: 100vh;
    position: relative;
    background: transparent;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* 固定渐变背景 */
.bg-gradient {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, #fde68a 0%, #a78bfa 50%, #60a5fa 100%);
    z-index: -1;
}

/* 内容滚动区域 */
.content-scroll {
    flex: 1;
    min-height: 0;
    box-sizing: border-box;
}

/* 内容卡片 */
.content-card {
    margin: 24rpx;
    padding: 40rpx 32rpx;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 24rpx;
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

/* 标题区 */
.header-section {
    text-align: center;
    padding-bottom: 32rpx;
    border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
    margin-bottom: 32rpx;
}

.main-title {
    display: block;
    font-size: 40rpx;
    font-weight: bold;
    color: #7c3aed;
    margin-bottom: 16rpx;
}

.update-date {
    display: block;
    font-size: 24rpx;
    color: #999;
}

/* 欢迎语 */
.intro-section {
    padding: 24rpx;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.08) 0%, rgba(96, 165, 250, 0.08) 100%);
    border-radius: 16rpx;
    margin-bottom: 32rpx;
}

.intro-text {
    font-size: 28rpx;
    color: #444;
    line-height: 1.8;
}

/* 章节 */
.section {
    margin-bottom: 40rpx;
}

.section-title {
    display: flex;
    align-items: center;
    margin-bottom: 24rpx;
}

.section-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48rpx;
    height: 48rpx;
    background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 100%);
    color: #fff;
    font-size: 24rpx;
    font-weight: bold;
    border-radius: 50%;
    margin-right: 16rpx;
}

.section-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

/* 条款内容 */
.section-content {
    padding-left: 16rpx;
}

.item {
    display: flex;
    margin-bottom: 20rpx;
    align-items: flex-start;
}

.item-number {
    font-size: 26rpx;
    color: #7c3aed;
    font-weight: 500;
    margin-right: 12rpx;
    flex-shrink: 0;
    min-width: 48rpx;
}

.item-text {
    font-size: 28rpx;
    color: #555;
    line-height: 1.7;
    flex: 1;
}

/* 底部声明 */
.footer-section {
    margin-top: 40rpx;
    padding-top: 32rpx;
    border-top: 1rpx solid rgba(0, 0, 0, 0.08);
    text-align: center;
}

.footer-text {
    font-size: 26rpx;
    color: #666;
    line-height: 1.6;
}
