<!--pages/plan-detail/plan-detail.wxml-->
<view class="page-container">
  <!-- 固定渐变背景层 -->
  <view class="bg-gradient"></view>

  <!-- 固定导航栏 -->
  <custom-navbar title="行程详情" showBack="{{true}}"></custom-navbar>

  <!-- Loading State -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <block wx:elif="{{!plan}}">
    <view class="empty-container">
      <text>暂无行程数据</text>
    </view>
  </block>

  <block wx:else>
    <scroll-view scroll-y class="content-scroll">
      <!-- Header Info -->
      <view class="header-info">
        <view class="city-title">
          <text class="city-name">{{plan.city}}</text>
          <text class="date-range">{{plan.date}} 至 {{plan.endDate}}</text>
        </view>
        <view class="trip-meta">
          <text class="meta-tag">{{plan.days}}天</text>
          <text class="meta-tag">{{plan.transportation}}</text>
        </view>
      </view>

      <!-- Weather Card -->
      <view class="weather-card" wx:if="{{currentWeather}}">
        <view class="weather-header">
          <text class="weather-emoji">{{currentWeather.emoji}}</text>
          <text class="weather-text">{{currentWeather.day_weather}}</text>
        </view>
        <view class="weather-temps">
          <text class="temp-high">{{currentWeather.day_temp}}°</text>
          <text class="temp-sep">/</text>
          <text class="temp-low">{{currentWeather.night_temp}}°</text>
        </view>
        <text class="weather-wind">{{currentWeather.wind_direction}} {{currentWeather.wind_power}}</text>
      </view>

      <!-- Route Summary (V2) -->
      <view class="route-summary-card" wx:if="{{currentRouteInfo}}">
        <view class="route-summary-header">
          <text class="route-summary-emoji">{{routeSummaryIcon}}</text>
          <text class="route-summary-title">今日路程概况</text>
          <!-- 查看地图按钮 -->
          <view class="view-map-btn" wx:if="{{currentDayMapUrl}}" bindtap="onViewRouteMap">
            <text class="map-icon">🗺️</text>
            <text>查看地图</text>
          </view>
        </view>
        <view class="route-summary-stats">
          <view class="stat-item">
            <text class="stat-value">{{currentRouteInfo.totalDistanceText}}</text>
            <text class="stat-label">总距离</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{currentRouteInfo.totalDurationText}}</text>
            <text class="stat-label">预计时长</text>
          </view>
          <view class="stat-item" wx:if="{{currentRouteInfo.traffic_lights}}">
            <text class="stat-value">{{currentRouteInfo.traffic_lights}}</text>
            <text class="stat-label">红绿灯</text>
          </view>
        </view>
      </view>

      <!-- Days Tabs -->
      <view class="tabs-wrapper">
        <scroll-view scroll-x class="tabs-scroll" enable-flex>
          <block wx:for="{{plan.schedule}}" wx:key="day_index">
            <view class="tab-item {{currentDay === index ? 'active' : ''}}" bindtap="onDayChange" data-index="{{index}}">
              <text class="tab-text">第{{item.day_index + 1}}天</text>
              <text class="tab-date">{{item.date}}</text>
            </view>
          </block>
        </scroll-view>
      </view>

      <!-- Content -->
      <view class="content-wrapper">
        <!-- Day Description -->
        <view class="day-desc-card" wx:if="{{currentDayData.description}}">
          <text class="day-desc">{{currentDayData.description}}</text>
        </view>

        <!-- V2 新结构：Planning Timeline（统一时间轴） -->
        <view class="planning-card" wx:if="{{currentDayData.isV2}}">
          <view class="section-header">
            <text class="section-emoji">📋</text>
            <text class="section-title">今日行程</text>
            <text class="section-count">{{currentDayData.planning.length}}个地点</text>
          </view>
          
          <view class="planning-timeline">
            <block wx:for="{{currentDayData.planning}}" wx:key="index" wx:for-item="item" wx:for-index="itemIndex">
              <!-- 路程信息段（非首项显示） -->
              <view class="route-segment" wx:if="{{itemIndex > 0 && currentRouteInfo}}">
                <view class="route-segment-header" bindtap="toggleRouteDetail" data-index="{{itemIndex}}">
                  <view class="route-icon">{{routeSegmentIcons[itemIndex] || '🚗'}}</view>
                  <view class="route-summary-inline">
                    <text class="route-distance">{{currentRouteInfo.location_names[itemIndex - 1]}} → {{currentRouteInfo.location_names[itemIndex]}}</text>
                  </view>
                  <view class="route-expand-icon">{{expandedRoutes[itemIndex] ? '▲' : '▼'}}</view>
                </view>
                
                <!-- 展开的路径详情 -->
                <view class="route-detail-list" wx:if="{{expandedRoutes[itemIndex]}}">
                  <block wx:for="{{currentRouteInfo.segments}}" wx:key="segment_index" wx:for-item="seg">
                    <view class="route-detail-item" wx:if="{{seg.instruction}}">
                      <text class="route-action-icon">{{seg.actionIcon}}</text>
                      <text class="route-instruction">{{seg.instruction}}</text>
                      <text class="route-segment-distance" wx:if="{{seg.distanceText}}">{{seg.distanceText}}</text>
                    </view>
                  </block>
                </view>
              </view>

              <!-- 地点项目 -->
              <view class="timeline-item {{item.typeCategory}}">
                <view class="timeline-left">
                  <view class="timeline-dot" style="background: {{item.typeColor}};">
                    <text class="dot-emoji">{{item.typeEmoji}}</text>
                  </view>
                  <view class="timeline-line" wx:if="{{itemIndex < currentDayData.planning.length - 1}}"></view>
                </view>
                <view class="timeline-content">
                  <view class="item-header">
                    <text class="type-tag" style="background: {{item.typeColor}};">{{item.typeLabel}}</text>
                    <text class="item-name">{{item.name}}</text>
                    <!-- 查看地图图标 -->
                    <view class="item-map-icon" catchtap="onShowRouteSegment" data-from-index="{{itemIndex - 1}}" data-to-index="{{itemIndex}}" wx:if="{{currentRouteInfo}}">🗺️</view>
                  </view>
                  <text class="item-address" wx:if="{{item.address}}">📍 {{item.address}}</text>
                  <view class="item-meta">
                    <text class="meta-item duration" wx:if="{{item.durationText}}">⏱️ {{item.durationText}}</text>
                    <text class="meta-item price" wx:if="{{item.priceText}}">💰 {{item.priceText}}</text>
                    <text class="meta-item category" wx:if="{{item.category}}">{{item.category}}</text>
                  </view>
                  <text class="item-desc" wx:if="{{item.description}}">{{item.description}}</text>
                </view>
              </view>
            </block>
          </view>
        </view>

        <!-- 原有结构：分离的景点和餐饮卡片 -->
        <block wx:if="{{!currentDayData.isV2}}">
          <!-- Attractions Timeline -->
          <view class="attractions-card" wx:if="{{currentDayData.attractions && currentDayData.attractions.length > 0}}">
            <view class="section-header">
              <text class="section-emoji">🗺️</text>
              <text class="section-title">今日景点</text>
            </view>
            <view class="timeline">
              <block wx:for="{{currentDayData.attractions}}" wx:key="name">
                <view class="timeline-item">
                  <view class="timeline-left">
                    <view class="timeline-dot"></view>
                    <view class="timeline-line" wx:if="{{index < currentDayData.attractions.length - 1}}"></view>
                  </view>
                  <view class="timeline-content">
                    <text class="attraction-name">{{item.name}}</text>
                    <text class="attraction-address">{{item.address}}</text>
                    <view class="attraction-meta">
                      <text class="meta-item duration">{{item.visit_duration}}分钟</text>
                      <text class="meta-item ticket" wx:if="{{item.ticket_price > 0}}">门票 ¥{{item.ticket_price}}</text>
                      <text class="meta-item ticket" wx:else>免费</text>
                    </view>
                    <text class="attraction-desc" wx:if="{{item.description}}">{{item.description}}</text>
                  </view>
                </view>
              </block>
            </view>
          </view>

          <!-- Meals Card -->
          <view class="meals-card" wx:if="{{currentDayData.meals && currentDayData.meals.length > 0}}">
            <view class="section-header">
              <text class="section-emoji">🍽️</text>
              <text class="section-title">餐饮推荐</text>
            </view>
            <view class="meals-list">
              <block wx:for="{{currentDayData.meals}}" wx:key="type">
                <view class="meal-item">
                  <text class="meal-type">{{item.typeLabel}}</text>
                  <view class="meal-info">
                    <text class="meal-name">{{item.name}}</text>
                    <text class="meal-desc">{{item.description}}</text>
                  </view>
                  <text class="meal-cost">¥{{item.estimated_cost}}</text>
                </view>
              </block>
            </view>
          </view>

          <!-- Hotel Card (原有结构) -->
          <view class="hotel-card" wx:if="{{currentDayData.hotel}}">
            <view class="section-header">
              <text class="section-emoji">🏨</text>
              <text class="section-title">住宿推荐</text>
            </view>
            <view class="hotel-info">
              <text class="hotel-name">{{currentDayData.hotel.name}}</text>
              <text class="hotel-address">{{currentDayData.hotel.address}}</text>
              <view class="hotel-meta">
                <text class="hotel-price">{{currentDayData.hotel.price_range}}</text>
                <text class="hotel-cost" wx:if="{{currentDayData.hotel.estimated_cost}}">预估 ¥{{currentDayData.hotel.estimated_cost}}</text>
              </view>
            </view>
          </view>
        </block>

        <!-- Budget Card -->
        <view class="budget-card" wx:if="{{plan.budget && plan.budget.total}}">
          <view class="section-header">
            <text class="section-emoji">💰</text>
            <text class="section-title">预算估算</text>
          </view>
          <view class="budget-list">
            <view class="budget-item">
              <text class="budget-label">住宿费用</text>
              <text class="budget-value">¥{{plan.budget.total_hotels}}</text>
            </view>
            <view class="budget-item">
              <text class="budget-label">景点门票</text>
              <text class="budget-value">¥{{plan.budget.total_attractions}}</text>
            </view>
            <view class="budget-item">
              <text class="budget-label">餐饮费用</text>
              <text class="budget-value">¥{{plan.budget.total_meals}}</text>
            </view>
            <view class="budget-item">
              <text class="budget-label">交通费用</text>
              <text class="budget-value">¥{{plan.budget.total_transportation}}</text>
            </view>
            <view class="budget-item total">
              <text class="budget-label">总计</text>
              <text class="budget-value">¥{{plan.budget.total}}</text>
            </view>
          </view>
        </view>

        <!-- Suggestions Card -->
        <view class="suggestions-card" wx:if="{{plan.overallSuggestions}}">
          <view class="section-header">
            <text class="section-emoji">💡</text>
            <text class="section-title">出行建议</text>
          </view>
          <text class="suggestions-text">{{plan.overallSuggestions}}</text>
        </view>

        <!-- Bottom Placeholder -->
        <view class="bottom-placeholder"></view>
      </view>
    </scroll-view>
  </block>

  <!-- 路线地图弹框 -->
  <route-map-popup
    visible="{{showRouteMapPopup}}"
    origin="{{routeMapOrigin}}"
    destination="{{routeMapDestination}}"
    originName="{{routeMapOriginName}}"
    destinationName="{{routeMapDestinationName}}"
    city="{{plan.city}}"
    defaultMode="{{routeMapDefaultMode}}"
    bind:close="onCloseRouteMapPopup"
  ></route-map-popup>
</view>
