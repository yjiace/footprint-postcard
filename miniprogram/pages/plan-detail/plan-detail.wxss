/* pages/plan-detail/plan-detail.wxss */

/* 固定背景层 - 覆盖整个屏幕，不随滚动移动 */
.bg-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #fde68a 0%, #a78bfa 50%, #60a5fa 100%);
  z-index: -1;
}

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
}

.loading-container,
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #FFFFFF;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top: 6rpx solid #FFFFFF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.content-scroll {
  flex: 1;
  min-height: 0;
}

/* Header Info */
.header-info {
  padding: 50rpx 32rpx 24rpx;
}

.city-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.city-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.date-range {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.trip-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.meta-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.25);
  font-size: 24rpx;
  color: #FFFFFF;
}

/* Weather Card */
.weather-card {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.weather-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.weather-emoji {
  font-size: 40rpx;
}

.weather-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.weather-temps {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.temp-high {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.temp-sep {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.temp-low {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.weather-wind {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: auto;
}

/* Route Summary Card (V2新增) */
.route-summary-card {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
}

.route-summary-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.route-summary-emoji {
  font-size: 32rpx;
}

.route-summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.route-summary-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* Tabs */
.tabs-wrapper {
  padding: 0 32rpx 16rpx;
}

.tabs-scroll {
  display: flex;
  white-space: nowrap;
  width: 100%;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background-color: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: rgba(255, 255, 255, 0.5);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.tab-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* Content */
.content-wrapper {
  padding: 0 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Cards Common */
.day-desc-card,
.planning-card,
.hotel-card,
.attractions-card,
.meals-card,
.budget-card,
.suggestions-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-emoji {
  font-size: 36rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.section-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #6b7280;
}

.day-desc {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

/* ====== V2 Planning Timeline 统一时间轴 ====== */
.planning-timeline {
  display: flex;
  flex-direction: column;
}

/* 路程信息段 */
.route-segment {
  margin: 16rpx 0 16rpx 36rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #3b82f6;
}

.route-segment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.route-icon {
  font-size: 28rpx;
}

.route-summary-inline {
  flex: 1;
}

.route-distance {
  font-size: 24rpx;
  color: #1e40af;
  font-weight: 500;
}

.route-expand-icon {
  font-size: 20rpx;
  color: #3b82f6;
  padding: 8rpx;
}

/* 展开的路径详情 */
.route-detail-list {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(59, 130, 246, 0.3);
  max-height: 400rpx;
  overflow-y: auto;
}

.route-detail-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 22rpx;
  color: #374151;
}

.route-action-icon {
  font-size: 24rpx;
  color: #3b82f6;
  flex-shrink: 0;
  width: 32rpx;
  text-align: center;
}

.route-instruction {
  flex: 1;
  line-height: 1.4;
}

.route-segment-distance {
  font-size: 20rpx;
  color: #6b7280;
  flex-shrink: 0;
}

/* Timeline Item (通用) */
.timeline-item {
  display: flex;
  flex-direction: row;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  width: 48rpx;
  flex-shrink: 0;
}

.timeline-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a78bfa 0%, #60a5fa 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(167, 139, 250, 0.3);
}

.dot-emoji {
  font-size: 24rpx;
}

.timeline-line {
  width: 4rpx;
  background: linear-gradient(180deg, #a78bfa 0%, #60a5fa 100%);
  flex-grow: 1;
  min-height: 32rpx;
  border-radius: 2rpx;
}

.timeline-content {
  flex: 1;
  padding-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.timeline-item:last-child .timeline-content {
  padding-bottom: 0;
}

/* Item Header with Type Tag */
.item-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.type-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.item-address {
  font-size: 24rpx;
  color: #6b7280;
}

.item-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}

.item-meta .meta-item {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background-color: #f3f4f6;
  color: #4b5563;
}

.item-meta .meta-item.duration {
  background-color: #ede9fe;
  color: #7c3aed;
}

.item-meta .meta-item.price {
  background-color: #fef3c7;
  color: #d97706;
}

.item-desc {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.5;
  margin-top: 8rpx;
}

/* ====== 原有结构样式（兼容） ====== */

/* Attractions Timeline (原有) */
.timeline {
  display: flex;
  flex-direction: column;
}

.attraction-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.attraction-address {
  font-size: 26rpx;
  color: #6b7280;
}

.attraction-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}

.attraction-meta .meta-item {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.attraction-meta .meta-item.duration {
  background-color: #ede9fe;
  color: #7c3aed;
}

.attraction-meta .meta-item.ticket {
  background-color: #fef3c7;
  color: #d97706;
}

.attraction-desc {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.5;
  margin-top: 8rpx;
}

/* Hotel (原有) */
.hotel-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hotel-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.hotel-address {
  font-size: 26rpx;
  color: #6b7280;
}

.hotel-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.hotel-price {
  font-size: 26rpx;
  color: #a78bfa;
  font-weight: 500;
}

.hotel-cost {
  font-size: 26rpx;
  color: #f97316;
  font-weight: 600;
}

/* Meals (原有) */
.meals-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meal-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 16rpx;
}

.meal-type {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
  flex-shrink: 0;
}

.meal-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meal-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C1C1E;
}

.meal-desc {
  font-size: 24rpx;
  color: #6b7280;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meal-cost {
  font-size: 28rpx;
  font-weight: 600;
  color: #f97316;
  flex-shrink: 0;
}

/* Budget */
.budget-list {
  display: flex;
  flex-direction: column;
}

.budget-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.budget-item:last-child {
  border-bottom: none;
}

.budget-item.total {
  margin-top: 8rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #e5e7eb;
  border-bottom: none;
}

.budget-label {
  font-size: 28rpx;
  color: #4b5563;
}

.budget-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C1C1E;
}

.budget-item.total .budget-label {
  font-weight: 600;
  color: #1C1C1E;
}

.budget-item.total .budget-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #a78bfa;
}

/* Suggestions */
.suggestions-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* Bottom Placeholder */
.bottom-placeholder {
  height: 100rpx;
}
