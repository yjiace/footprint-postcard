<!--pages/plan/plan.wxml-->
<view class="page-container">
  <!-- 固定渐变背景层 -->
  <view class="bg-gradient"></view>

  <!-- 导航栏带返回按钮和标题 -->
  <custom-navbar title="新增规划" showBack="{{true}}"></custom-navbar>

  <scroll-view class="content-scroll" scroll-y>
    <view class="form-container">
      <!-- 选择城市 -->
      <view class="form-item">
        <text class="form-label">选择城市</text>
        <view class="city-input-container">
          <picker mode="region" value="{{cityRegion}}" bindchange="onCityChange" class="city-picker">
            <view class="city-input">
              <text class="{{city ? 'picker-value' : 'picker-placeholder'}}">
                {{city || '例如:上海'}}
              </text>
            </view>
          </picker>
          <view class="location-btn" bindtap="useCurrentLocation" catchtap="useCurrentLocation">
            <view class="icon icon-location"></view>
          </view>
        </view>
      </view>

      <!-- 出行日期 -->
      <view class="form-item">
        <text class="form-label">出行日期</text>
        <view class="date-range-wrapper">
          <picker mode="date" value="{{startDate}}" start="{{todayDate}}" end="{{maxStartDate}}" bindchange="onStartDateChange" class="date-picker-half">
            <view class="date-half-input">
              <text class="{{startDate ? 'picker-value' : 'picker-placeholder'}}">
                {{startDate || '开始日期'}}
              </text>
            </view>
          </picker>
          <text class="date-separator">至</text>
          <picker mode="date" value="{{endDate}}" start="{{startDate || todayDate}}" end="{{maxEndDate}}" bindchange="onEndDateChange" class="date-picker-half">
            <view class="date-half-input">
              <text class="{{endDate ? 'picker-value' : 'picker-placeholder'}}">
                {{endDate || '结束日期'}}
              </text>
            </view>
          </picker>
          <text class="date-days-tag" wx:if="{{startDate && endDate}}">{{tripDays}}天</text>
        </view>
      </view>

      <!-- 交通方式 -->
      <view class="form-item">
        <text class="form-label">交通方式</text>
        <view class="type-tags">
          <view 
            class="type-tag {{item.selected ? 'type-tag-active' : ''}}" 
            wx:for="{{transportTypes}}" 
            wx:key="id"
            bindtap="onTransportToggle"
            data-index="{{index}}"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 住宿偏好 -->
      <view class="form-item">
        <text class="form-label">住宿偏好</text>
        <view class="type-tags">
          <view 
            class="type-tag {{item.selected ? 'type-tag-active' : ''}}" 
            wx:for="{{accommodationTypes}}" 
            wx:key="id"
            bindtap="onAccommodationToggle"
            data-index="{{index}}"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 景点类型偏好 -->
      <view class="form-item">
        <text class="form-label">景点类型偏好</text>
        <view class="type-tags">
          <view 
            class="type-tag {{item.selected ? 'type-tag-active' : ''}}" 
            wx:for="{{poiTypes}}" 
            wx:key="id"
            bindtap="onPoiTypeToggle"
            data-index="{{index}}"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 备注 -->
      <view class="form-item">
        <text class="form-label">备注</text>
        <textarea 
          class="textarea-input" 
          placeholder="可说明人数、关系或预算等信息" 
          placeholder-class="textarea-placeholder"
          value="{{notes}}"
          bindblur="onNotesChange"
          maxlength="200"
        ></textarea>
      </view>

      <!-- 生成按钮 -->
      <view class="generate-btn-container">
        <button class="generate-btn" bindtap="onGenerate">开始规划</button>
        <text class="bottom-tip">点击后将为您生成详细行程,按天展示景点并按时间排序。</text>
      </view>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-placeholder"></view>
  </scroll-view>
</view>
