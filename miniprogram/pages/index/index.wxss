/* pages/index/index.wxss */
/* 基于HTML原型: from-amber-200 via-violet-400 to-sky-400 */

/* 固定背景层 - 覆盖整个屏幕，不随滚动移动 */
.bg-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #fde68a 0%, #a78bfa 50%, #60a5fa 100%);
  z-index: -1;
}

.page-container {
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 定位徽章样式（在导航栏左侧插槽中使用） */
.location-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
}

.location-icon {
  font-size: 28rpx;
  color: #FFFFFF;
}

.location-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.content-scroll {
  flex: 1;
  min-height: 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.03rpx;
}

.section-more {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

/* 热门目的地 */
.destinations-container {
  padding: 0 32rpx;
}

.destinations-scroll {
  white-space: nowrap;
  -ms-scrollbar-style: none;
  scrollbar-width: none;
}

.destinations-scroll::-webkit-scrollbar {
  display: none;
}

.destinations-list {
  display: inline-flex;
  gap: 24rpx;
}

.destination-item {
  display: inline-flex;
  flex-direction: column;
  gap: 16rpx;
  border-radius: 16rpx;
  min-width: 560rpx;
  flex-shrink: 0;
}

.destination-image-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 16/9;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.destination-image {
  width: 100%;
  height: 100%;
}

.destination-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
}

.destination-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.03rpx;
}

/* 指示器 */
.indicators {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
}

.indicator-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.5);
  transition: all 0.3s;
}

.indicator-dot.active {
  background-color: #FFFFFF;
}

/* 规划行程入口 */
.plan-action {
  padding: 16rpx 32rpx 24rpx;
}

.plan-action-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.plan-action-btn:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.4);
}

.plan-action-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.plan-action-icon {
  font-size: 48rpx;
}

.plan-action-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.plan-action-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.plan-action-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.plan-action-arrow {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 周边景点 */
.attractions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 32rpx;
}

.attraction-item {
  display: flex;
  gap: 32rpx;
  background-color: rgba(255, 255, 255, 0.3);
  padding: 24rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  transition: all 0.3s;
}

.attraction-item:active {
  transform: scale(0.98);
  background-color: rgba(255, 255, 255, 0.4);
}

.attraction-image {
  width: 192rpx;
  height: 192rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.attraction-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.attraction-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: -0.03rpx;
}

.attraction-tags {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 400;
  line-height: 1.5;
}

.attraction-distance {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 400;
  line-height: 1.5;
}

.attraction-address {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 暂无数据占位 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 80rpx 32rpx;
  margin: 0 32rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.empty-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
}

.bottom-placeholder {
  height: 40rpx;
}
