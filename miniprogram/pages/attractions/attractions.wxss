/* pages/attractions/attractions.wxss */

/* 固定背景层 */
.bg-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #fde68a 0%, #a78bfa 50%, #60a5fa 100%);
  z-index: -1;
}

.page-container {
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 搜索栏 - 透明风格 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
}

/* 关键字搜索输入框 - 透明风格 */
.search-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  border-radius: 40rpx;
  padding: 0 20rpx;
  height: 68rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 68rpx;
  font-size: 26rpx;
  color: #FFFFFF;
}

.placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.clear-btn {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(0, 0, 0, 0.15);
  border-radius: 50%;
  margin-left: 8rpx;
}

/* 筛选下拉框 - 透明风格 */
.filter-picker {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  border-radius: 40rpx;
  padding: 0 20rpx;
  height: 68rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  white-space: nowrap;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.filter-picker .arrow {
  font-size: 20rpx;
  color: #FFFFFF;
  margin-left: 8rpx;
  opacity: 0.9;
}

/* 搜索按钮 - 透明风格 */
.search-btn {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(10rpx);
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.search-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.5);
}

/* CSS 搜索图标 */
.search-icon-svg {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  position: relative;
}

.search-icon-svg::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 4rpx;
  background: #FFFFFF;
  right: -10rpx;
  bottom: -2rpx;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

/* 结果统计 */
.result-count {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 内容滚动区域 */
.content-scroll {
  flex: 1;
  min-height: 0;
}

/* 景点列表 */
.attractions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 24rpx;
}

.attraction-item {
  display: flex;
  gap: 20rpx;
  background-color: rgba(255, 255, 255, 0.25);
  padding: 20rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.attraction-item:active {
  transform: scale(0.98);
  background-color: rgba(255, 255, 255, 0.35);
}

.attraction-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.attraction-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  min-width: 0;
}

.attraction-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attraction-tags {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attraction-distance {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.attraction-address {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 12rpx;
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 没有更多 */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
}

/* 回到顶部按钮 */
.back-to-top {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(10rpx);
  border-radius: 50%;
  font-size: 36rpx;
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.3s ease;
  pointer-events: none;
}

.back-to-top.show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.back-to-top:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.5);
}

/* 初次加载 */
.initial-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: #FFFFFF;
  font-size: 28rpx;
}

.initial-loading .loading-spinner {
  width: 44rpx;
  height: 44rpx;
}

.bottom-placeholder {
  height: 40rpx;
}
