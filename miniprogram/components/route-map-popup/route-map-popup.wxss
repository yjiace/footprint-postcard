/* 路线地图弹框组件样式 */
.route-map-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: visibility 0.3s, opacity 0.3s;
}

.route-map-popup.visible {
  visibility: visible;
  opacity: 1;
}

/* 遮罩层 */
.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

/* 弹框内容 */
.popup-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
}

.route-map-popup.visible .popup-content {
  transform: translateY(0);
}

/* 拖拽条 */
.drag-bar {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.drag-indicator {
  width: 60rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
}

/* 头部信息 */
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.route-info {
  flex: 1;
}

.route-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.arrow {
  color: #8b5cf6;
}

.route-summary {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.separator {
  color: #ddd;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 28rpx;
  color: #666;
}

/* 交通方式切换 */
.mode-tabs {
  display: flex;
  padding: 16rpx 32rpx;
  gap: 16rpx;
  background: #fafafa;
}

.mode-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #e0e0e0;
  transition: all 0.2s;
}

.mode-tab.active {
  background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
  border-color: transparent;
}

.mode-tab.active .mode-icon,
.mode-tab.active .mode-label {
  color: #fff;
}

.mode-icon {
  font-size: 32rpx;
}

.mode-label {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8b5cf6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #666;
}

/* 错误状态 */
.error-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.error-icon {
  font-size: 48rpx;
}

.error-text {
  font-size: 26rpx;
  color: #666;
}

.retry-btn {
  padding: 16rpx 48rpx;
  background: #8b5cf6;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  margin-top: 16rpx;
}

/* 地图区域 */
.map-container {
  height: 400rpx;
  margin: 16rpx 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.route-map {
  width: 100%;
  height: 100%;
}

/* 导航步骤列表 */
.steps-container {
  flex: 1;
  padding: 0 32rpx;
  max-height: 300rpx;
}

.steps-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  padding-top: 8rpx;
}

.step-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.step-item:last-child {
  border-bottom: none;
}

.step-icon {
  width: 48rpx;
  height: 48rpx;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #666;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-instruction {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

.step-detail {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.bus-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b5cf6;
}

/* 底部导航按钮 */
.bottom-actions {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.3);
}

.nav-icon {
  font-size: 32rpx;
}

.nav-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}
