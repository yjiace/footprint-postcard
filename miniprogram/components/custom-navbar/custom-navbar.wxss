/* components/custom-navbar/custom-navbar.wxss */

/* 导航栏容器 - 非固定，跟随页面滚动 */
.navbar-fixed {
  width: 100%;
  box-sizing: border-box;
  /* 透明背景，页面渐变贯穿 */
  background: transparent;
}

/* 导航栏内容区 */
.navbar-content {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  box-sizing: border-box;
}

/* 左侧区域 */
.navbar-left {
  min-width: 200rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

/* 返回按钮 */
.back-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 40rpx;
  backdrop-filter: blur(10rpx);
  transition: all 0.2s;
}

.back-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.4);
}

.back-icon {
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.back-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

/* 中间标题区 */
.navbar-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 320rpx;
}

/* 右侧区域（与胶囊按钮对应，留空） */
.navbar-right {
  min-width: 200rpx;
}

/* 占位元素已移除，不再需要 */
.navbar-placeholder {
  display: none;
}