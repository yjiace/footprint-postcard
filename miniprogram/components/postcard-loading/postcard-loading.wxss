/* components/postcard-loading/postcard-loading.wxss */

/* 全屏遮罩层 - 半透明背景 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
}

/* 主内容区 - 居中卡片 */
.loading-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
  border-radius: 32rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.25);
  max-width: 85%;
  animation: cardAppear 0.3s ease-out;
}

@keyframes cardAppear {
  0% {
    opacity: 0;
    transform: scale(0.9) translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* 明信片动画区 */
.postcard-animation {
  position: relative;
  width: 360rpx;
  height: 250rpx;
  margin-bottom: 48rpx;
  perspective: 1000rpx;
}

/* 明信片翻转容器 */
.postcard-flip {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  animation: cardFloat 4s ease-in-out infinite;
}

.postcard-flip.flip {
  animation: cardFlip 4s ease-in-out infinite;
}

@keyframes cardFloat {
  0%, 100% {
    transform: translateY(0) rotateY(0deg);
  }
  50% {
    transform: translateY(-16rpx) rotateY(5deg);
  }
}

@keyframes cardFlip {
  0%, 45% {
    transform: rotateY(0deg);
  }
  50%, 95% {
    transform: rotateY(180deg);
  }
  100% {
    transform: rotateY(360deg);
  }
}

/* 明信片正面 */
.postcard-front {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
  border-radius: 20rpx;
  backface-visibility: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  box-sizing: border-box;
}

.postcard-image-placeholder {
  flex: 1;
  background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.postcard-emoji {
  font-size: 80rpx;
  animation: emojiPulse 2s ease-in-out infinite;
}

@keyframes emojiPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

.postcard-lines {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.postcard-lines .line {
  height: 8rpx;
  background: linear-gradient(90deg, #e5e7eb, #d1d5db);
  border-radius: 4rpx;
  animation: lineShimmer 1.5s ease-in-out infinite;
}

.postcard-lines .line.short {
  width: 60%;
}

@keyframes lineShimmer {
  0%, 100% {
    opacity: 0.5;
  }
  50% {
    opacity: 1;
  }
}

/* 明信片背面 */
.postcard-back {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 20rpx;
  backface-visibility: hidden;
  transform: rotateY(180deg);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  display: flex;
  padding: 20rpx;
  box-sizing: border-box;
}

.stamp-area {
  width: 80rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #fecaca 0%, #fca5a5 100%);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 4rpx dashed #ef4444;
}

.stamp-emoji {
  font-size: 40rpx;
}

.address-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.address-lines .line {
  height: 6rpx;
  background: #d97706;
  border-radius: 3rpx;
  opacity: 0.4;
}

.address-lines .line.short {
  width: 50%;
}

/* 邮戳盖章动画 */
.stamp-animation {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0) rotate(-15deg);
  opacity: 0;
  pointer-events: none;
}

.stamp-animation.show {
  animation: stampPress 2s ease-in-out infinite;
}

@keyframes stampPress {
  0%, 70% {
    transform: translate(-50%, -50%) scale(0) rotate(-15deg);
    opacity: 0;
  }
  75% {
    transform: translate(-50%, -50%) scale(1.3) rotate(-15deg);
    opacity: 1;
  }
  80%, 100% {
    transform: translate(-50%, -50%) scale(1) rotate(-15deg);
    opacity: 0.9;
  }
}

.stamp-circle {
  width: 120rpx;
  height: 120rpx;
  border: 8rpx solid #dc2626;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
}

.stamp-text {
  font-size: 60rpx;
  color: #dc2626;
  font-weight: bold;
}

/* 画笔绘制动画 */
.drawing-animation {
  display: flex;
  gap: 40rpx;
  margin-bottom: 40rpx;
}

.brush {
  font-size: 44rpx;
  animation: brushFloat 2s ease-in-out infinite;
}

.brush-1 {
  animation-delay: 0s;
}

.brush-2 {
  animation-delay: 0.3s;
}

.brush-3 {
  animation-delay: 0.6s;
}

@keyframes brushFloat {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-12rpx) rotate(-10deg);
  }
  75% {
    transform: translateY(-8rpx) rotate(10deg);
  }
}

/* 动态提示语 */
.tip-text {
  margin-bottom: 40rpx;
  text-align: center;
}

.tip-content {
  font-size: 30rpx;
  color: #6b7280;
  font-weight: 500;
  animation: tipFade 3s ease-in-out infinite;
}

@keyframes tipFade {
  0%, 100% {
    opacity: 0.7;
  }
  50% {
    opacity: 1;
  }
}

/* 模拟进度条 */
.progress-container {
  width: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #e5e7eb;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #a78bfa, #60a5fa, #a78bfa);
  background-size: 200% 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease-out;
  animation: progressShine 2s linear infinite;
}

@keyframes progressShine {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.progress-text {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 500;
}
