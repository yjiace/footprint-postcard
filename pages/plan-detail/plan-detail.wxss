/* pages/plan-detail/plan-detail.wxss */
.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #fde68a 0%, #a78bfa 50%, #60a5fa 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-top: 88rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.loading-container,
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #FFFFFF;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top: 6rpx solid #FFFFFF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Header Info */
.header-info {
  padding: 24rpx 32rpx;
}

.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.25);
  margin-bottom: 16rpx;
}

.back-icon {
  font-size: 28rpx;
  color: #FFFFFF;
}

.back-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.city-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.city-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.date-range {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.trip-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.meta-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.25);
  font-size: 24rpx;
  color: #FFFFFF;
}

/* Weather Card */
.weather-card {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.weather-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.weather-emoji {
  font-size: 40rpx;
}

.weather-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.weather-temps {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.temp-high {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.temp-sep {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.temp-low {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.weather-wind {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: auto;
}

/* Tabs */
.tabs-wrapper {
  padding: 0 32rpx 16rpx;
}

.tabs-scroll {
  display: flex;
  white-space: nowrap;
  width: 100%;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background-color: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: rgba(255, 255, 255, 0.5);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.tab-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* Content */
.content-scroll {
  flex: 1;
  box-sizing: border-box;
}

.content-wrapper {
  padding: 0 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Cards Common */
.day-desc-card,
.hotel-card,
.attractions-card,
.meals-card,
.budget-card,
.suggestions-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-emoji {
  font-size: 36rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

/* Day Description */
.day-desc {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

/* Hotel */
.hotel-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hotel-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.hotel-address {
  font-size: 26rpx;
  color: #6b7280;
}

.hotel-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.hotel-price {
  font-size: 26rpx;
  color: #a78bfa;
  font-weight: 500;
}

.hotel-cost {
  font-size: 26rpx;
  color: #f97316;
  font-weight: 600;
}

/* Timeline */
.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  flex-direction: row;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  width: 24rpx;
  flex-shrink: 0;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a78bfa 0%, #60a5fa 100%);
  margin-bottom: 8rpx;
}

.timeline-line {
  width: 4rpx;
  background: linear-gradient(180deg, #a78bfa 0%, #60a5fa 100%);
  flex-grow: 1;
  min-height: 32rpx;
  border-radius: 2rpx;
}

.timeline-content {
  flex: 1;
  padding-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.timeline-item:last-child .timeline-content {
  padding-bottom: 0;
}

.attraction-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.attraction-address {
  font-size: 26rpx;
  color: #6b7280;
}

.attraction-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}

.meta-item {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.meta-item.duration {
  background-color: #ede9fe;
  color: #7c3aed;
}

.meta-item.ticket {
  background-color: #fef3c7;
  color: #d97706;
}

.attraction-desc {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.5;
  margin-top: 8rpx;
}

/* Meals */
.meals-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meal-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 16rpx;
}

.meal-type {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
  flex-shrink: 0;
}

.meal-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meal-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C1C1E;
}

.meal-desc {
  font-size: 24rpx;
  color: #6b7280;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meal-cost {
  font-size: 28rpx;
  font-weight: 600;
  color: #f97316;
  flex-shrink: 0;
}

/* Budget */
.budget-list {
  display: flex;
  flex-direction: column;
}

.budget-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.budget-item:last-child {
  border-bottom: none;
}

.budget-item.total {
  margin-top: 8rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #e5e7eb;
  border-bottom: none;
}

.budget-label {
  font-size: 28rpx;
  color: #4b5563;
}

.budget-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C1C1E;
}

.budget-item.total .budget-label {
  font-weight: 600;
  color: #1C1C1E;
}

.budget-item.total .budget-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #a78bfa;
}

/* Suggestions */
.suggestions-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* Bottom Placeholder */
.bottom-placeholder {
  height: 100rpx;
}
