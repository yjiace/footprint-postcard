/* pages/plan/plan.wxss */
/* 基于HTML原型: from-amber-200 via-violet-400 to-sky-400 */

/* ============================================
   页面容器
   ============================================ */
.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #fde68a 0%, #a78bfa 50%, #60a5fa 100%);
  display: flex;
  flex-direction: column;
  padding-top: 88rpx;
}

.header {
  padding: 32rpx;
}

.header-top {
  margin-bottom: 16rpx;
}

/* 统一返回按钮样式 */
.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 48rpx;
  backdrop-filter: blur(20rpx);
  transition: all 0.3s;
}

.back-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.3);
}

.back-icon {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.back-text {
  font-size: 28rpx;
  color: #FFFFFF;
}

.page-title {
  font-size: 60rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.content-scroll {
  flex: 1;
  padding: 0 32rpx;
}

/* ============================================
   表单容器
   ============================================ */
.form-container {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* ============================================
   城市选择器
   ============================================ */
.city-input-container {
  display: flex;
  align-items: stretch;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  overflow: hidden;
  height: 80rpx;
}

.city-picker {
  flex: 1;
  display: flex;
  align-items: center;
}

.city-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.city-input text {
  display: block;
  width: 100%;
  line-height: 0;
}

.location-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.location-btn:active {
  background-color: rgba(255, 255, 255, 0.4);
}

.location-btn .icon-location {
  font-size: 36rpx;
  color: #FFFFFF;
}

/* ============================================
   日期区间选择器
   ============================================ */
.date-range-wrapper {
  display: flex;
  align-items: stretch;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  padding: 0 16rpx;
  height: 80rpx;
  box-sizing: border-box;
}

.date-picker-half {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-half-input {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-half-input text {
  text-align: center;
  line-height: 0;
}

.date-separator {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

.date-days-tag {
  font-size: 22rpx;
  color: #FFFFFF;
  background-color: rgba(255, 255, 255, 0.3);
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 8rpx;
}

/* ============================================
   通用Picker文字样式
   ============================================ */
.picker-placeholder {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.picker-value {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* ============================================
   标签选择器（交通/住宿/景点类型）
   ============================================ */
.type-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-tag {
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  background-color: rgba(255, 255, 255, 0.3);
  font-size: 28rpx;
  color: #FFFFFF;
  transition: all 0.3s;
  backdrop-filter: blur(10rpx);
}

.type-tag:active {
  transform: scale(0.95);
}

.type-tag-active {
  background-color: rgba(255, 255, 255, 0.5);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.5);
}

/* ============================================
   备注输入框
   ============================================ */
.textarea-input {
  width: 100%;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: rgba(255, 255, 255, 0.3);
  font-size: 28rpx;
  color: #FFFFFF;
  min-height: 160rpx;
  border: none;
  backdrop-filter: blur(10rpx);
  box-sizing: border-box;
}

.textarea-placeholder {
  color: rgba(255, 255, 255, 0.8);
}

/* ============================================
   生成按钮
   ============================================ */
.generate-btn-container {
  margin-top: 48rpx;
  padding: 0;
}

.generate-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 9999rpx;
  font-size: 36rpx;
  font-weight: 700;
  background-color: #FFFFFF;
  color: #a78bfa;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.generate-btn::after {
  border: none;
}

.bottom-tip {
  display: block;
  margin-top: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

/* ============================================
   底部占位
   ============================================ */
.bottom-placeholder {
  height: 60rpx;
}
