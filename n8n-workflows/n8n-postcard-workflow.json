{
  "name": "明信片生成工作流 (动态Key版)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "postcard-generate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "postcard-generate"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"received\": true,\n  \"message\": \"Task started\"\n}",
        "options": {}
      },
      "id": "respond-node",
      "name": "立即响应",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        460,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.kuai.host/v1beta/models/gemini-3-pro-image-preview:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Webhook').item.json.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"contents\": [{\n    \"role\": \"user\",\n    \"parts\": [{\n      \"text\": $('Webhook').item.json.prompt\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseModalities\": [\"TEXT\", \"IMAGE\"],\n    \"imageConfig\": {\n      \"aspectRatio\": \"3:4\",\n      \"imageSize\": \"2K\"\n    }\n  }\n} }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "ai-request-node",
      "name": "调用AI接口",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Webhook').item.json.callback.url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"postcardId\": $('Webhook').item.json.callback.postcardId,\n  \"openid\": $('Webhook').item.json.callback.openid,\n  \"aiResponse\": $json\n} }}",
        "options": {}
      },
      "id": "callback-request-node",
      "name": "回调EdgeOne",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "调用AI接口",
            "type": "main",
            "index": 0
          },
          {
            "node": "立即响应",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "调用AI接口": {
      "main": [
        [
          {
            "node": "回调EdgeOne",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}